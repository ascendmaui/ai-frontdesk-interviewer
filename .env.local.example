# ─── Required ───────────────────────────────────────────
XAI_API_KEY=xai-your-key-here

# ─── Slack ──────────────────────────────────────────────
# Incoming webhook (hiring scorecards) — works without bot
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Bot token for channel create + post to #leads-inbound etc.
# Scopes: channels:manage, channels:read, chat:write, groups:write
# SLACK_BOT_TOKEN=xoxb-...

# ─── Email (pick ONE path) ──────────────────────────────
# Option A — Resend (recommended for production)
RESEND_API_KEY=re_xxx
HIRING_FROM_EMAIL=Hiring <hiring@yourdomain.com>

# Option B — Gmail SMTP (app password)
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# HIRING_FROM_EMAIL=you@gmail.com

# Optional: also email yourself a copy of every scorecard
HIRING_NOTIFY_EMAIL=you@yourdomain.com

# ─── Product ────────────────────────────────────────────
# Shown to candidates who pass (strong_yes / yes)
FINAL_INTERVIEW_CALENDAR_URL=https://cal.com/your-team/final

# Public site URL (used in Slack links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin pipeline at /admin
ADMIN_SECRET=change-me-to-a-long-random-string

# ─── Onboarding links (sent after HM pass) ──────────────
# ONBOARDING_SLACK_INVITE_URL=https://join.slack.com/t/...
# ONBOARDING_HANDBOOK_URL=https://notion.so/...
# ONBOARDING_CRM_URL=https://...

# ─── Optional voice/model overrides ─────────────────────
# XAI_VOICE=eve
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_EVAL_MODEL=grok-3-mini

# ─── Hearthline control plane (CRM spine + provision) ───
# Spine secret must match Vercel env on hearthline-platform (HEARTHLINE_SPINE_SECRET)
HEARTHLINE_SPINE_SECRET=
HEARTHLINE_SPINE_URL=https://hearthline-platform.vercel.app
# Provision shim on platform (can equal spine secret, or separate if set on platform)
HEARTHLINE_PROVISION_SECRET=
HEARTHLINE_OS_URL=https://hearthline-platform.vercel.app
# ONBOARDING_CRM_URL=https://hearthline-platform.vercel.app/app
