# ─── Required voice/evaluation provider ─────────────────
XAI_API_KEY=xai-your-key-here

# Private durable storage. Run `npm run db:setup` once before deployment.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ─── AI Sales Coach (preferred) ─────────────────────────
# If absent, the coach falls back to the server-side XAI_API_KEY above.
OPENAI_API_KEY=
OPENAI_SALES_COACH_MODEL=gpt-5.6-sol

# ─── Slack ──────────────────────────────────────────────
# Incoming webhook (hiring scorecards) — works without bot
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Bot token for channel create + post to #leads-inbound etc.
# Scopes: channels:manage, channels:read, chat:write, groups:write
# SLACK_BOT_TOKEN=xoxb-...

# ─── Email (pick ONE path) ──────────────────────────────
# Option A — Resend (recommended for production)
RESEND_API_KEY=re_xxx
HIRING_FROM_EMAIL=Hiring <hiring@yourdomain.com>

# Option B — Gmail SMTP (app password)
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# HIRING_FROM_EMAIL=you@gmail.com

# Optional: also email yourself a copy of every scorecard
HIRING_NOTIFY_EMAIL=you@yourdomain.com

# ─── Product ────────────────────────────────────────────
FINAL_INTERVIEW_CALENDAR_URL=https://cal.com/your-team/final
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin pipeline at /admin
ADMIN_SECRET=change-me-to-a-long-random-string

# ─── Offer / commission wording ─────────────────────────
# Optional overrides. The formal signed agreement must remain the source of truth.
# OFFER_COMMISSION_BLURB=Commission-only; exact percentage and collected-revenue rules are in the signed agreement.
# OFFER_START_BLURB=Start after onboarding and certification.
# OFFER_TERMS_HTML=

# ─── Onboarding links ───────────────────────────────────
ONBOARDING_SLACK_INVITE_URL=
ONBOARDING_HANDBOOK_URL=
ONBOARDING_CRM_URL=
ONBOARDING_DIALER_URL=

# Secure document/e-sign/payout providers. Do NOT point tax or payout tasks to
# ordinary forms that store bank details, SSNs/TINs, or identity documents in this app.
ONBOARDING_COMMISSION_AGREEMENT_URL=
ONBOARDING_CONFIDENTIALITY_URL=
ONBOARDING_COMPLIANCE_URL=
ONBOARDING_PAYOUT_URL=
ONBOARDING_TAX_FORM_URL=

# ─── Optional xAI voice/model overrides ────────────────
# XAI_VOICE=eve
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_EVAL_MODEL=grok-3-mini

# ─── Hearthline OS (post-certification provision) ───────
# Shared secret must match Vercel env on hearthline project
HEARTHLINE_PROVISION_SECRET=
HEARTHLINE_OS_URL=https://hearthline-gold.vercel.app
# NEXT_PUBLIC_HEARTHLINE_OS_URL=https://hearthline-gold.vercel.app
