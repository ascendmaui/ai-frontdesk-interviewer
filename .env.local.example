# ─── Required voice/evaluation provider ─────────────────
XAI_API_KEY=xai-your-key-here

# Private durable storage. Run `npm run db:setup` once before deployment.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ─── AI Sales Coach (preferred) ─────────────────────────
# If absent, the coach falls back to the server-side XAI_API_KEY above.
OPENAI_API_KEY=
OPENAI_SALES_COACH_MODEL=gpt-5.6-sol

# ─── Slack ──────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# SLACK_BOT_TOKEN=xoxb-...

# ─── Email ──────────────────────────────────────────────
RESEND_API_KEY=re_xxx
HIRING_FROM_EMAIL=Hiring <hiring@yourdomain.com>
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
HIRING_NOTIFY_EMAIL=you@yourdomain.com

# ─── Product ────────────────────────────────────────────
FINAL_INTERVIEW_CALENDAR_URL=https://cal.com/your-team/final
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_SECRET=change-me-to-a-long-random-string

# ─── Offer / commission wording ─────────────────────────
# OFFER_COMMISSION_BLURB=Commission-only; exact percentage and collected-revenue rules are in the signed agreement.
# OFFER_START_BLURB=Start after onboarding and certification.
# OFFER_TERMS_HTML=

# ─── Onboarding links ───────────────────────────────────
ONBOARDING_SLACK_INVITE_URL=
ONBOARDING_HANDBOOK_URL=
ONBOARDING_CRM_URL=https://hearthline-platform.vercel.app/app
ONBOARDING_DIALER_URL=
ONBOARDING_COMMISSION_AGREEMENT_URL=
ONBOARDING_CONFIDENTIALITY_URL=
ONBOARDING_COMPLIANCE_URL=
ONBOARDING_PAYOUT_URL=
ONBOARDING_TAX_FORM_URL=

# ─── Optional xAI voice/model overrides ─────────────────
# XAI_VOICE=eve
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_EVAL_MODEL=grok-3-mini

# ─── Hearthline control plane / canonical spine ─────────
HEARTHLINE_SPINE_SECRET=
HEARTHLINE_SPINE_URL=https://hearthline-platform.vercel.app
HEARTHLINE_PROVISION_SECRET=
HEARTHLINE_OS_URL=https://hearthline-platform.vercel.app
NEXT_PUBLIC_HEARTHLINE_OS_URL=https://hearthline-platform.vercel.app
